# Exact browser origins, comma-separated. Set the deployed frontend explicitly.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Optional providers. Without them, verified imagery/screening remain available.
GEOCHAT_ENDPOINT_URL=
GEOCHAT_TIMEOUT_SECONDS=45
GEOCHAT_ATTEMPTS=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Mount a persistent volume here in production. Run ONE uvicorn worker.
SATQUERY_DATA_DIR=/tmp/satquery
MAX_ACTIVE_JOBS=2
ANALYSIS_TIMEOUT_SECONDS=240
