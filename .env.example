# Optional GeoChat service implementing Contract A. Leave blank to use deterministic
# demo answers while developing locally.
GEOCHAT_ENDPOINT_URL=
# Optional Gemini key for the query-router integration. Do not commit a real key.
GEMINI_API_KEY=
# Browser origin allowed to call this API in production, for example
# https://satquery-frontend.onrender.com. Leave blank only for same-origin hosting.
FRONTEND_URL=
# Set to false only when Earth Engine credentials are configured.
DEMO_MODE=true
