# Optional GeoChat Contract A URL. Either the tunnel base URL or its complete
# `/infer` URL is accepted. Set this in Render; never commit a tunnel URL.
GEOCHAT_ENDPOINT_URL=
# Cold-started model servers can take longer than a typical HTTP request.
GEOCHAT_TIMEOUT_SECONDS=90
GEOCHAT_ATTEMPTS=2
# Optional Gemini key for the query-router integration. Do not commit a real key.
GEMINI_API_KEY=
# Comma-separated extra browser origins allowed to call this API. The Vercel
# production domain is allowed by default; add a custom frontend domain here.
FRONTEND_URL=
# Set to false only when Earth Engine credentials are configured.
DEMO_MODE=true
